# Copy to .env and fill in. Never commit .env.

# --- Steps 0–5 / 7: Token Factory + media endpoints ---
TOKEN_FACTORY_API_KEY=
IMAGE_ENDPOINT_URL=
IMAGE_ENDPOINT_TOKEN=
VIDEO_ENDPOINT_URL=
VIDEO_ENDPOINT_TOKEN=
AUDIO_ENDPOINT_URL=
AUDIO_ENDPOINT_TOKEN=

# Alternate Token Factory llm models (uncomment one to try):
# SANTA_LLM_MODEL=zai-org/GLM-5.3-Flash
# SANTA_LLM_MODEL=nvidia/Nemotron-3.5-Lightning
# SANTA_LLM_MODEL=deepseek-ai/DeepSeek-V4-Pro

# --- Fallbacks (SANTA_FALLBACK=auto|off|only, default auto) ---
OPENAI_API_KEY=
SANTA_FALLBACK=auto

# --- Batch / service / publish ---
SANTA_SERVICE_URL=
NEBIUS_IAM_TOKEN=
NEBIUS_PROJECT_ID=
NEBIUS_SUBNET_ID=
NEBIUS_BUCKET_ID=
NEBIUS_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL=https://storage.eu-north1.nebius.cloud:443
